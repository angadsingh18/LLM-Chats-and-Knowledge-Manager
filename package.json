{
  "name": "ai-manager",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @ai-manager/api dev",
    "dev:web": "pnpm --filter @ai-manager/web dev",
    "dev:ext": "pnpm --filter @ai-manager/extension dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@neon/config": "^1.14.2",
    "@neon/env": "^2.1.5"
  }
}
