# API
NODE_ENV=development
PORT=3001
# Neon: `neon deploy` / `neon env pull` writes real values into .env (never commit that file).
# Pooled (PgBouncer) URL for app traffic:
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct URL for migrations/tooling:
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
# Origin allowed to call the API (web app dev server)
WEB_ORIGIN=http://localhost:5173

# Auth (Google OAuth). Create an OAuth client (type: Web application) in Google Cloud Console.
# Authorized redirect URI must be: http://localhost:5173/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only these emails may sign in (comma-separated). Recommended while developing.
ALLOWED_EMAILS=
